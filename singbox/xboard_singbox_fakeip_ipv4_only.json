{
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "dns_proxy",
        "type": "https",
        "server": "1.1.1.1",
        "path": "/dns-query",
        "detour": "Proxy"
      },
      {
        "tag": "dns_direct",
        "type": "https",
        "server": "223.5.5.5",
        "path": "/dns-query"
      },
      {
        "tag": "dns_local",
        "type": "local"
      },
      {
        "tag": "dns_fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15"
      }
    ],
    "rules": [
      {
        "query_type": [
          "AAAA",
          "HTTPS",
          "SVCB"
        ],
        "action": "predefined",
        "rcode": "NOERROR"
      },
      {
        "rule_set": [
          "geosite-private",
          "local-extra"
        ],
        "action": "route",
        "server": "dns_local"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "server": "dns_direct"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "Global",
            "query_type": [
              "A"
            ]
          },
          {
            "rule_set": [
              "dns-realip",
              "direct-check"
            ],
            "invert": true
          }
        ],
        "action": "route",
        "server": "dns_fakeip"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "server": "dns_proxy"
      },
      {
        "rule_set": [
          "direct-check",
          "direct-extra"
        ],
        "action": "route",
        "server": "dns_direct"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "rule_set": [
              "speedtest-domainset",
              "ai",
              "paypal",
              "stream-jp",
              "stream-tw",
              "stream",
              "geosite-telegram",
              "apple-proxy"
            ],
            "query_type": [
              "A"
            ]
          },
          {
            "rule_set": [
              "dns-realip"
            ],
            "invert": true
          }
        ],
        "action": "route",
        "server": "dns_fakeip"
      },
      {
        "rule_set": [
          "speedtest-domainset",
          "ai",
          "paypal",
          "stream-jp",
          "stream-tw",
          "stream",
          "geosite-telegram",
          "apple-proxy"
        ],
        "action": "route",
        "server": "dns_proxy"
      },
      {
        "rule_set": [
          "apple-domainset",
          "apple",
          "microsoft-cdn"
        ],
        "action": "route",
        "server": "dns_direct"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "rule_set": [
              "download-domainset",
              "download",
              "geosite-google"
            ],
            "query_type": [
              "A"
            ]
          },
          {
            "rule_set": [
              "dns-realip"
            ],
            "invert": true
          }
        ],
        "action": "route",
        "server": "dns_fakeip"
      },
      {
        "rule_set": [
          "download-domainset",
          "download",
          "geosite-google"
        ],
        "action": "route",
        "server": "dns_proxy"
      },
      {
        "rule_set": [
          "domestic",
          "direct",
          "cn-domain"
        ],
        "action": "route",
        "server": "dns_direct"
      },
      {
        "rule_set": [
          "dns-realip"
        ],
        "action": "route",
        "server": "dns_proxy"
      },
      {
        "query_type": [
          "A"
        ],
        "action": "route",
        "server": "dns_fakeip"
      }
    ],
    "reverse_mapping": true,
    "final": "dns_proxy",
    "strategy": "ipv4_only"
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "store_fakeip": true
    },
    "clash_api": {
      "default_mode": "Rule"
    }
  },
  "http_clients": [
    {
      "tag": "http_proxy",
      "detour": "Proxy"
    }
  ],
  "services": [
    {
      "type": "api",
      "tag": "api",
      "listen": "127.0.0.1",
      "listen_port": 9090,
      "secret": "REPLACE_WITH_SECRET",
      "access_control_allow_origin": [
        "http://127.0.0.1:9090",
        "http://localhost:9090"
      ],
      "access_control_allow_private_network": true,
      "dashboard": {
        "enabled": true
      }
    },
    {
      "type": "api",
      "tag": "api-lan",
      "listen": "0.0.0.0",
      "listen_port": 9091,
      "secret": "REPLACE_WITH_SECRET",
      "access_control_allow_origin": [
        "http://127.0.0.1:9090",
        "http://localhost:9090"
      ],
      "access_control_allow_private_network": true,
      "dashboard": {
        "enabled": true,
        "path": "dashboard-lan"
      }
    }
  ],
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 1400,
      "auto_route": true,
      "strict_route": true,
      "stack": "mixed",
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 2334
        }
      }
    },
    {
      "type": "socks",
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "listen_port": 2333
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 2334
    }
  ],
  "outbounds": [
    {
      "tag": "Proxy",
      "type": "selector",
      "outbounds": [],
      "include": ".*"
    },
    {
      "tag": "HK",
      "type": "selector",
      "outbounds": [],
      "include": "🇭🇰|香港|(?<![A-Za-z])(?:HKG?|Hong[ -]?Kong)(?![A-Za-z])",
      "fallback": "Proxy"
    },
    {
      "tag": "TW",
      "type": "selector",
      "outbounds": [],
      "include": "🇹🇼|台湾|台灣|(?<![A-Za-z])(?:TWN?|Taiwan)(?![A-Za-z])",
      "fallback": "Proxy"
    },
    {
      "tag": "JP",
      "type": "selector",
      "outbounds": [],
      "include": "🇯🇵|日本|(?<![A-Za-z])(?:JPN?|Japan)(?![A-Za-z])",
      "fallback": "Proxy"
    },
    {
      "tag": "SG",
      "type": "selector",
      "outbounds": [],
      "include": "🇸🇬|新加坡|(?<![A-Za-z])(?:SGP?|Singapore)(?![A-Za-z])",
      "fallback": "Proxy"
    },
    {
      "tag": "US",
      "type": "selector",
      "outbounds": [],
      "include": "🇺🇸|美国|(?<![A-Za-z])(?:USA?|United[ -]?States)(?![A-Za-z])",
      "fallback": "Proxy"
    },
    {
      "tag": "DE",
      "type": "selector",
      "outbounds": [],
      "include": "🇩🇪|德国|(?<![A-Za-z])(?:DEU?|GER|Germany)(?![A-Za-z])",
      "fallback": "Proxy"
    },
    {
      "tag": "Speedtest",
      "type": "selector",
      "outbounds": [],
      "include": "🇭🇰|🇹🇼|🇯🇵|🇸🇬|香港|台湾|台灣|日本|新加坡|(?<![A-Za-z])(?:HKG?|TWN?|JPN?|SGP?|Hong[ -]?Kong|Taiwan|Japan|Singapore)(?![A-Za-z])",
      "fallback": "Proxy"
    },
    {
      "tag": "AIGC",
      "type": "selector",
      "outbounds": [],
      "include": "^(?=.*(?:🇹🇼|🇯🇵|🇸🇬|🇺🇸|🇬🇧|台湾|台灣|日本|新加坡|美国|英国|(?<![A-Za-z])(?:TWN?|JPN?|SGP?|USA?|UK|GBR?|Taiwan|Japan|Singapore|United[ -]?States|United[ -]?Kingdom)(?![A-Za-z])))(?=.*(?:家宽|(?<![A-Za-z])(?:SoftBank|Nuro|Ucom|IIJ|Starlink|ATT|Verizon|Frontier|Hawaii)(?![A-Za-z])))",
      "fallback": "Proxy"
    },
    {
      "tag": "PayPal",
      "type": "selector",
      "default": "US",
      "outbounds": [
        "US",
        "HK",
        "Direct"
      ],
      "_filter": "none"
    },
    {
      "tag": "GlobalMedia",
      "type": "selector",
      "outbounds": [],
      "include": "🇭🇰|🇹🇼|🇸🇬|香港|台湾|台灣|新加坡|(?<![A-Za-z])(?:HKG?|TWN?|SGP?|Hong[ -]?Kong|Taiwan|Singapore)(?![A-Za-z])",
      "fallback": "Proxy"
    },
    {
      "tag": "Telegram",
      "type": "selector",
      "outbounds": [],
      "include": "🇭🇰|🇯🇵|香港|日本|(?<![A-Za-z])(?:HKG?|JPN?|Hong[ -]?Kong|Japan)(?![A-Za-z])",
      "fallback": "Proxy"
    },
    {
      "tag": "MSCDN",
      "type": "selector",
      "default": "Direct",
      "outbounds": [
        "Direct",
        "Proxy"
      ],
      "_filter": "none"
    },
    {
      "tag": "Download",
      "type": "selector",
      "outbounds": [],
      "include": "🇭🇰|🇯🇵|香港|日本|(?<![A-Za-z])(?:HKG?|JPN?|Hong[ -]?Kong|Japan)(?![A-Za-z])",
      "fallback": "Proxy"
    },
    {
      "tag": "Google",
      "type": "selector",
      "outbounds": [],
      "include": "🇺🇸|美国|(?<![A-Za-z])(?:USA?|United[ -]?States)(?![A-Za-z])",
      "fallback": "Proxy"
    },
    {
      "tag": "GlobalEmby",
      "type": "selector",
      "outbounds": [],
      "include": "🇭🇰|🇯🇵|🇸🇬|香港|日本|新加坡|(?<![A-Za-z])(?:HKG?|JPN?|SGP?|Hong[ -]?Kong|Japan|Singapore)(?![A-Za-z])",
      "fallback": "Proxy"
    },
    {
      "tag": "RFCEmby",
      "type": "selector",
      "outbounds": [],
      "include": "^(?=.*(?:🇭🇰|🇯🇵|🇸🇬|香港|日本|新加坡|(?<![A-Za-z])(?:HKG?|JPN?|SGP?|Hong[ -]?Kong|Japan|Singapore)(?![A-Za-z])))(?=.*(?:RFC|Jinx))",
      "fallback": "Proxy"
    },
    {
      "tag": "Final",
      "type": "selector",
      "default": "Proxy",
      "outbounds": [
        "Proxy",
        "Direct"
      ],
      "_filter": "none"
    },
    {
      "tag": "Direct",
      "type": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_http_client": "http_proxy",
    "default_domain_resolver": {
      "server": "dns_direct",
      "strategy": "ipv4_only"
    },
    "final": "Final",
